<?xml version='1.0' encoding='windows-1252'?>
<!--
  MSI installer, built by `cargo wix` in the release workflow. Variables such as
  $(var.Version) and $(var.CargoTargetBinDir) are filled in by cargo-wix.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder"?>
<?else?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder"?>
<?endif?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='modev'
        UpgradeCode='6B34A0DC-9581-4401-AABA-A14563D2A819'
        Manufacturer='modev contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Device simulator and DevTools-style inspector for mobile web apps.'
            Manufacturer='modev contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252' />

        <!-- Installing a newer version replaces the old one. -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed.' />

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='*'>
                    <Shortcut Id='StartMenuShortcut' Name='Modev' Description='Device simulator for web apps'
                        WorkingDirectory='APPLICATIONFOLDER' Icon='ProductICO' Target='[!exe0]' />
                    <RegistryValue Root='HKCU' Key='Software\modev' Name='start_menu_shortcut'
                        Type='integer' Value='1' KeyPath='yes' />
                </Component>
            </Directory>

            <Directory Id='DesktopFolder'>
                <Component Id='DesktopShortcut' Guid='*'>
                    <Shortcut Id='DesktopShortcut' Name='Modev' Description='Device simulator for web apps'
                        WorkingDirectory='APPLICATIONFOLDER' Icon='ProductICO' Target='[!exe0]' />
                    <RegistryValue Root='HKCU' Key='Software\modev' Name='desktop_shortcut'
                        Type='integer' Value='1' KeyPath='yes' />
                </Component>
            </Directory>

            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='modev'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile' DiskId='1' Source='wix\License.rtf' KeyPath='yes' />
                    </Component>
                    <Component Id='binary0' Guid='*'>
                        <File Id='exe0' Name='modev.exe' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\modev.exe' KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature Id='Application' Title='modev' Level='1' ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no' Display='expand' Absent='disallow'>
            <ComponentRef Id='License' />
            <ComponentRef Id='binary0' />
            <Feature Id='Shortcuts' Title='Shortcuts' Description='Start menu and desktop shortcuts.' Level='1'>
                <ComponentRef Id='StartMenuShortcut' />
                <ComponentRef Id='DesktopShortcut' />
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize' />
        <Icon Id='ProductICO' SourceFile='assets\app-icon\windows\modev.ico' />
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <Property Id='ARPHELPLINK' Value='https://github.com/yosoyjaff/modev' />

        <UI>
            <UIRef Id='WixUI_FeatureTree' />
        </UI>
        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf' />
    </Product>
</Wix>
